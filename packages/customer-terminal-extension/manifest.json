{
  "manifest_version": 3,
  "name": "GEO Customer Terminal",
  "version": "0.1.6",
  "key": "",
  "description": "Executes signed, domain-scoped GEO verification tasks without exporting session or human-verification material.",
  "permissions": ["storage", "tabs"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
