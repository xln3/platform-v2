GEO_ENV=development
GEO_LOG_LEVEL=INFO
GEO_POSTGRES_DSN=postgresql://geo:geo_dev_only@127.0.0.1:55433/geo_platform
GEO_CLICKHOUSE_URL=http://127.0.0.1:18123
GEO_TEMPORAL_ADDRESS=127.0.0.1:17233
GEO_TEMPORAL_NAMESPACE=default
GEO_TEMPORAL_TASK_QUEUE=geo-platform-v2
GEO_MINIO_ENDPOINT=http://127.0.0.1:19000
GEO_REDIS_URL=redis://127.0.0.1:16380/0
GEO_BOOTSTRAP_SECRET=replace-with-a-random-local-development-secret
# 报价单动态 Query、客户信息调研等功能复用这一组 LLM 配置；密钥只放本地/部署环境。
GEO_RESEARCH_LLM_API_KEY=
GEO_RESEARCH_LLM_MODEL=gpt-5.6-luna
# 品牌调研与 Service 2 共用这一套联网模型选项目录，但各自独立选择。
GEO_RESEARCH_LLM_MODELS=gpt-5.6-luna,qwen3.7-plus,gemini-3.1-pro-preview-search,claude-opus-5
GEO_RESEARCH_LLM_BASE_URL=https://api.inferera.com
GEO_RESEARCH_LLM_BASE_URL_FALLBACK=
# Service 2 key stays server-side. Leave it empty to reuse GEO_RESEARCH_LLM_API_KEY;
# never expose this variable through VITE_* or an HTTP request body.
GEO_SERVICE2_ANALYSIS_LLM_API_KEY=
GEO_SERVICE2_ANALYSIS_LLM_BASE_URL=https://api.inferera.com
GEO_SERVICE2_ANALYSIS_LLM_BASE_URL_FALLBACK=
