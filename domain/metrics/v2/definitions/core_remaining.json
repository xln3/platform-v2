[
  {
    "name": "ai_recommendation_entity_share_v2",
    "version": "2.0.0",
    "definition_schema_version": "metric-definition-v2",
    "status": "published",
    "unit_type": "relation",
    "focal_entity_required": true,
    "outcome_source": "semantic_decision",
    "query_predicate": {
      "all": [
        { "query_has_lens": "ai_recommendation" },
        { "query_has_operation": "recommend" },
        { "exposure_is": "brand_neutral" }
      ]
    },
    "required_semantic_capabilities": [
      {
        "name": "recommendation_relation",
        "task_ref": "recommendation-relation@2.0.0",
        "accepted_status": "ready"
      }
    ],
    "required_event_types": ["recommendation_relation"],
    "applicability": {
      "any": [
        {
          "event_exists": { "type": "recommendation_relation", "where": { "polarity": "positive" } }
        },
        {
          "event_exists": {
            "type": "recommendation_relation",
            "where": { "polarity": "conditional_positive" }
          }
        }
      ]
    },
    "outcome": {
      "count_outcome": {
        "from_events": "recommendation_relation",
        "numerator_subject": "$focal_entity",
        "numerator_where": { "polarity": ["positive", "conditional_positive"] },
        "denominator_where": { "polarity": ["positive", "conditional_positive"] },
        "unique_by": "subject_entity_id",
        "credit_total": "one_per_answer"
      }
    },
    "missing_policy": "unknown_if_required_analysis_unready",
    "allowed_aggregation_methods": ["query_macro", "answer_weighted"],
    "default_aggregation_method": "query_macro",
    "reason_codes": {
      "hit": "recommendation_positive",
      "miss": "target_not_in_ranked_list",
      "not_applicable": "no_applicable_claim"
    },
    "metadata": { "release_role": "conditional_diagnostic", "metric_family": "entity_share" }
  },
