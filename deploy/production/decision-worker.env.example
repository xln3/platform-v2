# Keep provider credentials in the protected platform.env or secret store.
# Empty semantic key/base values reuse GEO_RESEARCH_LLM_API_KEY and
# GEO_RESEARCH_LLM_BASE_URL.  Set the dedicated values to isolate/override the
# automatic semantic judge without changing research or report generation.
GEO_DECISION_TEMPORAL_TASK_QUEUE=geo-platform-v2-decision
GEO_SEMANTIC_DECISION_MAX_CONCURRENT_ACTIVITIES=8
GEO_SEMANTIC_DECISION_BACKFILL_BATCH_SIZE=100
GEO_SEMANTIC_DECISION_LLM_API_KEY=
GEO_SEMANTIC_DECISION_LLM_BASE_URL=
GEO_SEMANTIC_DECISION_LLM_BASE_URL_FALLBACK=
GEO_SEMANTIC_DECISION_LLM_PROVIDER=openai-compatible
GEO_SEMANTIC_DECISION_LLM_MODEL=gpt-5.6-sol
GEO_SEMANTIC_DECISION_LLM_MODEL_REVISION=runtime-configured
GEO_SEMANTIC_DECISION_LLM_TIMEOUT_SECONDS=120
GEO_SEMANTIC_DECISION_LLM_MAX_RETRIES=2
# Positive enables calls; zero is an explicit operational spending stop and
# produces llm_api_budget_exhausted/failed, never semantic unknown or review.
GEO_SEMANTIC_DECISION_DAILY_BUDGET=100
GEO_SEMANTIC_DECISION_JUDGE_POLICY_VERSION=
