# This file is mandatory for the production unit and is loaded after
# platform.env.  Keep provider credentials in the protected platform.env or
# secret store; do not put them here.
GEO_ENV=production
GEO_DECISION_TEMPORAL_TASK_QUEUE=geo-platform-v2-decision
GEO_SEMANTIC_DECISION_MAX_CONCURRENT_ACTIVITIES=8
GEO_SEMANTIC_DECISION_BACKFILL_BATCH_SIZE=100
# Fail-closed shadow profile: zero prevents model spending.  The empty policy
# records that this profile has no approved default; workflow payloads still
# carry their immutable policy reference, and the current production adapter
# reports model-unavailable instead of calling a provider.  Activation requires
# a separate reviewed file, not an in-place edit of this example.
GEO_SEMANTIC_DECISION_DAILY_BUDGET=0
GEO_SEMANTIC_DECISION_JUDGE_POLICY_VERSION=
