# Keep provider credentials in the protected platform.env or secret store.
GEO_DECISION_TEMPORAL_TASK_QUEUE=geo-platform-v2-decision
GEO_SEMANTIC_DECISION_MAX_CONCURRENT_ACTIVITIES=8
GEO_SEMANTIC_DECISION_BACKFILL_BATCH_SIZE=100
# Zero disables automatic model spending; tasks remain pending/unknown until an
# explicit budget is configured.
GEO_SEMANTIC_DECISION_DAILY_BUDGET=0
GEO_SEMANTIC_DECISION_JUDGE_POLICY_VERSION=
