[Unit]
Description=GEO Platform V2 production backup (PostgreSQL + ClickHouse + MinIO)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=xln
Group=xln
WorkingDirectory=/home/xln/geo-system/platform-v2
# DSN/credentials are available via the env file (never inlined in this unit);
# the backup itself consumes no secrets — every datastore is read through
# `docker exec` inside its own container (see scripts/production_backup.py).
EnvironmentFile=-/etc/geo-platform-v2/platform.env
ExecStart=/home/xln/geo-system/platform-v2/.venv/bin/python scripts/production_backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/xln/geo-system/platform-v2/.production-backups
UMask=0077
