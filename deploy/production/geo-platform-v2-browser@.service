# 常驻浏览器（W8 跨 run CDP 复用）——2026-08-09 起浏览器矩阵化：实例 = 平台 ×
# 地域 × 账号，实例参数 %i = 实例键（{platform}_{regiontag}，如 doubao_sh）。
# 采集侧（geo-platform-v2-worker）batch 经 browser_router 路由到实例，按
# GEO_BROWSER_<KEY>_CDP_URL attach 本浏览器；实例未在 GEO_BROWSER_INSTANCES
# 清单里 = fail-closed（本服务可以不开，对应地域采集诚实报错）。
#
# 安装与启用（以 doubao_sh 为例）：
#   sudo install -m 0644 deploy/production/geo-platform-v2-browser@.service \
#       /etc/systemd/system/geo-platform-v2-browser@.service
#   sudo install -m 0600 deploy/production/browser-doubao_sh.env.example \
#       /etc/geo-platform-v2/browser-doubao_sh.env   # 安装后按注释编辑
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now geo-platform-v2-browser@doubao_sh
#   journalctl -u geo-platform-v2-browser@doubao_sh -f   # 看到 resident_browser_up + CDP URL 即就绪
# worker 侧打开 attach：在 /etc/geo-platform-v2/worker-adapters.env 的
#   GEO_BROWSER_INSTANCES 加入 doubao_sh 并配
#   GEO_BROWSER_DOUBAO_SH_CDP_URL=http://127.0.0.1:19222（端口须与
#   browser-doubao_sh.env 一致）+ GEO_BROWSER_DOUBAO_SH_EXIT_GB=310000
#   sudo systemctl restart geo-platform-v2-worker
#
# 运维注意：
# - 常驻浏览器持有 profile 目录锁与 CDP 端口；换代理/换 profile/换端口 = 改 env 后
#   systemctl restart geo-platform-v2-browser@doubao_sh（重启期间采集 attach 断连，
#   按 browser-launch-failed 诚实重试，重启完自愈）。
# - 停止常驻而 worker 仍把该实例留在清单里 → 该地域采集全部 browser-launch-failed
#   重试；下线请先把实例从 GEO_BROWSER_INSTANCES 摘掉再停本服务。
# - 同 profile 目录/同 CDP 端口的两个实例绝不能同时 active（矩阵迁入时先停旧
#   slug 实例再起新实例键实例，见 RESIDENT-BROWSERS.md 迁移一节）。
[Unit]
Description=GEO Platform V2 resident browser (%i) — CDP attach target for collectors
After=network-online.target display-manager.service
Wants=network-online.target
# headed Chromium 需要 DISPLAY 就绪（RESIDENT_DISPLAY，缺省 :1 本机 GNOME 桌面）；
# display-manager 起来后再启动，避免 X 未就绪导致 launch 失败空转重启。
After=graphical.target

[Service]
Type=simple
User=xln
Group=xln
WorkingDirectory=/home/xln/geo-system/platform-v2
EnvironmentFile=/etc/geo-platform-v2/browser-%i.env
ExecStart=/home/xln/geo-system/platform-v2/.venv/bin/python tools/resident_browser.py
# 失败即死（profile 锁/端口占用/崩溃/探活失败）→ 10s 后重启兜底。
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# profile 目录（RESIDENT_PROFILE_DIR）必须落在可写路径内。
ReadWritePaths=/home/xln/geo-system/platform-v2

[Install]
WantedBy=multi-user.target
