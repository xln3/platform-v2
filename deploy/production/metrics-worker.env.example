# This file is mandatory for the production unit and is loaded after
# platform.env.  The worker only publishes when a workflow payload explicitly
# requests a channel; shadow rollout must enqueue publication_channel=shadow.
# The database still rejects official publication unless every frozen
# dependency has reached its reviewed published state.
GEO_ENV=production
GEO_METRICS_TEMPORAL_TASK_QUEUE=geo-platform-v2-metrics
GEO_METRICS_MAX_CONCURRENT_ACTIVITIES=16
GEO_METRICS_SNAPSHOT_MAX_CONCURRENT_ACTIVITIES=4
GEO_METRICS_BACKFILL_BATCH_SIZE=500
