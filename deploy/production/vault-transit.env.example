# Non-secret production settings for the independently operated deletion authority.
# Do not enable until the Vault key, policy, TLS trust and restricted systemd
# credential file have been provisioned and independently approved.
GEO_KMS_PROVIDER=vault_transit
GEO_VAULT_TRANSIT_ADDRESS=https://vault.example.internal
GEO_VAULT_TRANSIT_TOKEN_FILE=/run/credentials/geo-platform-v2-api.service/vault-token
GEO_VAULT_TRANSIT_DELETION_TOKEN_FILE=/run/credentials/geo-platform-v2-worker.service/vault-deletion-token
# Prefix only. Runtime derives a non-identifying independent key name for each
# tenant+account, so deleting one Vault key invalidates that account in backups.
GEO_VAULT_TRANSIT_KEY_NAME=geo-platform-profile
