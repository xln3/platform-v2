[Unit]
Description=GEO Platform V2 Temporal Worker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=xln
Group=xln
WorkingDirectory=/home/xln/geo-system/platform-v2
EnvironmentFile=/etc/geo-platform-v2/platform.env
# Worker-only browser profiles and proxy credentials. Install from
# worker-adapters.env.example as root:root mode 0600; do not inline secrets here.
EnvironmentFile=/etc/geo-platform-v2/worker-adapters.env
EnvironmentFile=-/etc/geo-platform-v2/feishu-bot.env
EnvironmentFile=-/etc/geo-platform-v2/wukong.env
ExecStart=/home/xln/geo-system/platform-v2/.venv/bin/python -m workflows.workers.main
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/xln/geo-system/platform-v2

[Install]
WantedBy=multi-user.target
