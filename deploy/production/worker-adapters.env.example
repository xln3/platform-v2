# Copy to /etc/geo-platform-v2/worker-adapters.env and chmod 0600.
# This file is read only by the worker service. Never commit real credentials.
GEO_COLLECTION_ADAPTER=multi
DISPLAY=:1
GEO_ADAPTER_EVIDENCE_DIR=/home/xln/geo-system/platform-v2/runtime/adapter-evidence

# static = preserve per-platform URLs below; wukong = resolve every task.region
# to an existing, verified Wukong lease. Collection never creates orders.
GEO_REGION_PROXY_MODE=wukong
GEO_WUKONG_MODULE_ROOT=/home/xln/geo-system/server
GEO_WUKONG_CACHE=/home/xln/geo-system/platform-v2/runtime/wukong_leases.json
GEO_WUKONG_MIN_REMAINING_MIN=20
# Optional aliases outside the built-in 31 mainland ISO/GB mappings:
# GEO_REGION_GB_MAP=custom-beijing:110000,custom-chengdu:510100

GEO_DOUBAO_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/doubao-sh
GEO_DOUBAO_PROXY_URL=http://user:password@proxy.example:3128
GEO_DOUBAO_HEADLESS=0

GEO_DEEPSEEK_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/deepseek-tj
GEO_DEEPSEEK_PROXY_URL=http://user:password@proxy.example:3128
GEO_DEEPSEEK_HEADLESS=0

GEO_YUANBAO_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/yuanbao-tj
GEO_YUANBAO_PROXY_URL=http://user:password@proxy.example:3128
GEO_YUANBAO_HEADLESS=0

GEO_TONGYI_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/tongyi-bj
GEO_TONGYI_PROXY_URL=http://user:password@proxy.example:3128
GEO_TONGYI_HEADLESS=0

GEO_YIYAN_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/yiyan-sh
GEO_YIYAN_PROXY_URL=http://user:password@proxy.example:3128
GEO_YIYAN_HEADLESS=0

# W1 (2026-08-05): doubao deep_think 解锁 + SSE 结构化 trace 证据。
# /chat/completion 流式完成预算（秒，缺省 600，允许 30..3600）——deep_think 流远长于 normal。
# GEO_DOUBAO_CHAT_TIMEOUT_S=600
# SSE trace 与截图同目录落盘（GEO_DOUBAO_EVIDENCE_DIR / GEO_ADAPTER_EVIDENCE_DIR），无需新目录。
# collect_with_adapter 的 workflow start_to_close 预算（分钟，缺省 15；API 侧读取）。
# GEO_COLLECTION_ACTIVITY_TIMEOUT_MINUTES=15

# W4 (2026-08-05): 官网素材快照（own_source 引用页+官网主页/核心页，随采集 run 顺带）。
# 总开关（缺省 true；0/false/no/off → activity 直接 skipped 零 IO）。
# GEO_OWN_SITE_SNAPSHOT_ENABLED=1
# 官网页上限（缺省 5，硬夹 1..20；主页算 1 条）与 own_source 引用页上限（缺省 5，硬夹 1..20）。
# GEO_OWN_SITE_SNAPSHOT_LIMIT=5
# GEO_OWN_SITE_CITATION_LIMIT=5
# 可选代理（缺省直连；官网为公开页，通常不需要）。
# GEO_OWN_SITE_PROXY_URL=http://user:password@proxy.example:3128

# W2 (2026-08-05): 信源正文抓取+准确性核对（随采集 run 顺带，fetch→audit 串行）。
# 总开关（缺省 true；false → 两 activity 均 skipped 零 IO）。
# GEO_SOURCE_FETCH_ENABLED=1
# 每 run 抓取引用上限（缺省 5，硬夹 1..20）。
# GEO_SOURCE_FETCH_LIMIT=5
# 核对 LLM：逐项留空则复用 GEO_RESEARCH_LLM_*；key 缺失 → llm_unavailable 如实落库。
# GEO_AUDIT_LLM_API_KEY=
# GEO_AUDIT_LLM_BASE_URL=
# GEO_AUDIT_LLM_MODEL=

# W3 (2026-08-06): 拉踩检测（随 run 顺带，answer+source_document 切窗 LLM 判定）。
# GEO_DISPARAGEMENT_ENABLED=1
# 每 run 窗数上限（缺省 50，硬夹 1..200；超限如实截断计数）。
# GEO_DISPARAGEMENT_WINDOW_LIMIT=50

# W2 (2026-08-05): 信源正文抓取 + 准确性核对（fetch_run_sources / audit_run_sources）。
# 总开关（缺省 true；0/false/no/off → 两个 activity 都 skipped 零 IO）。
# GEO_SOURCE_FETCH_ENABLED=1
# 每 run 抓取的引用 URL 上限（缺省 5，硬夹 1..20；按 task 顺序+citation ordinal 取头 N）。
# GEO_SOURCE_FETCH_LIMIT=5
# 核对 LLM（OpenAI Responses API，非流式，60s 超时）：三项留空则逐项复用
# GEO_RESEARCH_LLM_API_KEY / GEO_RESEARCH_LLM_BASE_URL / GEO_RESEARCH_LLM_MODEL；
# key 缺失 → 判定口径如实落 llm_unavailable，绝不编造判定。
# GEO_AUDIT_LLM_API_KEY=
# GEO_AUDIT_LLM_BASE_URL=
# GEO_AUDIT_LLM_MODEL=

# W8 (2026-08-06): 常驻浏览器 CDP attach（跨 run 复用同一 Chromium 会话，采集不再冷启动）。
# 前置：geo-platform-v2-browser@doubao.service 已启用（env 见 browser-doubao.env.example，
# 端口须一致）。打开下行后 doubao 采集 attach 常驻浏览器；注释着=旧 launch 行为不变。
# 常驻服务重启/停止期间 attach 断连 → browser-launch-failed 诚实重试，恢复后自愈。
# GEO_DOUBAO_CDP_URL=http://127.0.0.1:19222
