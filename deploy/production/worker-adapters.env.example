# Copy to /etc/geo-platform-v2/worker-adapters.env and chmod 0600.
# This file is read only by the worker service. Never commit real credentials.
# Since collection-analysis-detached-v1 this process only captures artifacts
# that require the logged-in AI session. Put public-source settings in
# source-worker.env and semantic/risk settings in analysis-worker.env.
# During an upgrade only, set the following to 1 on one collector long enough
# to drain workflow histories started before the detach patch; leave it off for
# all new histories so analysis cannot occupy collection capacity.
# GEO_LEGACY_ANALYSIS_ON_COLLECTION_WORKER=0
GEO_COLLECTION_ADAPTER=multi
DISPLAY=:1
GEO_ADAPTER_EVIDENCE_DIR=/home/xln/geo-system/platform-v2/runtime/adapter-evidence

# static = preserve per-platform URLs below; wukong = resolve every task.region
# to an existing, verified Wukong lease. Collection never creates orders.
GEO_REGION_PROXY_MODE=wukong
GEO_WUKONG_MODULE_ROOT=/home/xln/geo-system/server
GEO_WUKONG_CACHE=/home/xln/geo-system/platform-v2/runtime/wukong_leases.json
GEO_WUKONG_MIN_REMAINING_MIN=20
# Optional aliases outside the built-in 31 mainland ISO/GB mappings:
# GEO_REGION_GB_MAP=custom-beijing:110000,custom-chengdu:510100

GEO_DOUBAO_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/doubao-sh
GEO_DOUBAO_PROXY_URL=http://user:password@proxy.example:3128
GEO_DOUBAO_HEADLESS=0

GEO_DEEPSEEK_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/deepseek-tj
GEO_DEEPSEEK_PROXY_URL=http://user:password@proxy.example:3128
GEO_DEEPSEEK_HEADLESS=0

GEO_YUANBAO_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/yuanbao-tj
GEO_YUANBAO_PROXY_URL=http://user:password@proxy.example:3128
GEO_YUANBAO_HEADLESS=0

GEO_TONGYI_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/tongyi-bj
GEO_TONGYI_PROXY_URL=http://user:password@proxy.example:3128
GEO_TONGYI_HEADLESS=0

GEO_YIYAN_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/yiyan-sh
GEO_YIYAN_PROXY_URL=http://user:password@proxy.example:3128
GEO_YIYAN_HEADLESS=0

# W1 (2026-08-05): doubao deep_think 解锁 + SSE 结构化 trace 证据。
# /chat/completion 流式完成预算（秒，缺省 600，允许 30..3600）——deep_think 流远长于 normal。
# GEO_DOUBAO_CHAT_TIMEOUT_S=600
# SSE trace 与截图同目录落盘（GEO_DOUBAO_EVIDENCE_DIR / GEO_ADAPTER_EVIDENCE_DIR），无需新目录。
# collect_with_adapter 的 workflow start_to_close 预算（分钟，缺省 15；API 侧读取）。
# GEO_COLLECTION_ACTIVITY_TIMEOUT_MINUTES=15

# W4: 官网素材快照（采集结束后由 source worker 独立执行；配置写 source-worker.env）。
# 总开关（缺省 true；0/false/no/off → activity 直接 skipped 零 IO）。
# GEO_OWN_SITE_SNAPSHOT_ENABLED=1
# 官网页上限（缺省 5，硬夹 1..20；主页算 1 条）与 own_source 引用页上限（缺省 5，硬夹 1..20）。
# GEO_OWN_SITE_SNAPSHOT_LIMIT=5
# GEO_OWN_SITE_CITATION_LIMIT=5
# 可选代理（缺省直连；官网为公开页，通常不需要）。
# GEO_OWN_SITE_PROXY_URL=http://user:password@proxy.example:3128

# W2: 信源正文由 source worker 抓取，随后由 analysis worker 审计；均不占采集 worker。
# 总开关（缺省 true；false → 两 activity 均 skipped 零 IO）。
# GEO_SOURCE_FETCH_ENABLED=1
# 兼容旧部署的批处理提示（缺省 200）；不会截断每份回答的 U 事实全集。
# GEO_SOURCE_FETCH_LIMIT=200
# 兼容旧部署的调度提示（缺省 20000）；不会截断 run 的 U 事实全集。相同 URL 只抓一次并扇出出现记录。
# GEO_SOURCE_FETCH_RUN_LIMIT=20000
# 核对 LLM：逐项留空则复用 GEO_RESEARCH_LLM_*；key 缺失 → llm_unavailable 如实落库。
# GEO_AUDIT_LLM_API_KEY=
# GEO_AUDIT_LLM_BASE_URL=
# GEO_AUDIT_LLM_MODEL=

# W3: 拉踩检测（采集结束后由 analysis worker 独立执行）。
# GEO_DISPARAGEMENT_ENABLED=1
# 每 run 窗数上限（缺省 50，硬夹 1..200；超限如实截断计数）。
# GEO_DISPARAGEMENT_WINDOW_LIMIT=50

# P3: 拉踩事实核查（analysis worker 中紧跟 disparagement 判定）。
# 对 disparagement=true 的判定逐条联网核查（复用 post_analysis 的 web_search
# transport；LLM 走 GEO_AUDIT_LLM_*，key 缺失 → 整体跳过零落库，绝不伪装
# unverifiable）。总开关（缺省 true）：
# GEO_DISPARAGEMENT_FACTCHECK_ENABLED=1
# 单 run 核查条数上限（缺省 20，硬夹 1..100；超限如实截断计数）。
# GEO_DISPARAGEMENT_FACTCHECK_LIMIT=20

# P3: 官网诊断建议（analysis worker 中紧跟 source-audit）。仅当本 run 有
# own_site 信源文档时执行；建议批次幂等（同 run+model+prompt_version 只产一批）。
# 总开关（缺省 true；LLM 同走 GEO_AUDIT_LLM_*，key 缺失 → 零调用零落库）：
# GEO_SITE_SUGGESTIONS_ENABLED=1

# P3 (2026-08-09): 己方内容拉踩检测（SOP article version 定稿
# publication_ready→true 时由 API 侧 outbox 触发 OwnContentDisparagementWorkflow）。
# 切窗+判定复用 W3 同口径，落 disparagement_judgment（content_origin='own_content'）。
# 竞品真源=sop.project brand_profile.competitors（空 → 安静跳过）。窗数上限复用
# GEO_DISPARAGEMENT_WINDOW_LIMIT。总开关（缺省 true）：
# GEO_OWN_CONTENT_DISPARAGEMENT_ENABLED=1

# W2 旧配置口径参考；实际值分别放 source-worker.env / analysis-worker.env。
# 总开关（缺省 true；0/false/no/off → 两个 activity 都 skipped 零 IO）。
# GEO_SOURCE_FETCH_ENABLED=1
# 兼容旧部署的批处理提示（缺省 200）；不会截断每份回答的 U 事实全集。
# GEO_SOURCE_FETCH_LIMIT=200
# 兼容旧部署的调度提示（缺省 20000）；不会截断 run 的 U 事实全集；跨回答 URL 去重抓取、出现记录保留。
# GEO_SOURCE_FETCH_RUN_LIMIT=20000
# 核对 LLM（OpenAI Responses API，非流式，60s 超时）：三项留空则逐项复用
# GEO_RESEARCH_LLM_API_KEY / GEO_RESEARCH_LLM_BASE_URL / GEO_RESEARCH_LLM_MODEL；
# key 缺失 → 判定口径如实落 llm_unavailable，绝不编造判定。
# GEO_AUDIT_LLM_API_KEY=
# GEO_AUDIT_LLM_BASE_URL=
# GEO_AUDIT_LLM_MODEL=

# W8 (2026-08-06): 常驻浏览器 CDP attach（跨 run 复用同一 Chromium 会话，采集不再冷启动）。
# 2026-08-09 起浏览器矩阵化：常驻实例 = 平台 × 地域 × 账号，实例键 =
# {platform}_{regiontag}（如 doubao_sh）。batch 按 (adapter, region) 切段后经
# workflows/activities/browser_router.py 路由到实例；无匹配实例 / 地域与实例
# 出口省码不符 / 清单畸形一律 fail-closed 诚实失败（绝不静默替换出口）。
# 前置：geo-platform-v2-browser@doubao_sh.service 已启用（env 见
# browser-doubao_sh.env.example，端口须一致）。未在清单里的平台/地域 = 采集
# 诚实报错（browser_instance_unavailable / region_exit_mismatch）。
# GEO_BROWSER_INSTANCES=doubao_sh,deepseek_tj,tongyi_bj,yiyan_sh,yuanbao_tj
# GEO_BROWSER_DOUBAO_SH_CDP_URL=http://127.0.0.1:19222
# GEO_BROWSER_DOUBAO_SH_EXIT_GB=310000
# GEO_BROWSER_DEEPSEEK_TJ_CDP_URL=http://127.0.0.1:19224
# GEO_BROWSER_DEEPSEEK_TJ_EXIT_GB=120000
# GEO_BROWSER_TONGYI_BJ_CDP_URL=http://127.0.0.1:19225
# GEO_BROWSER_TONGYI_BJ_EXIT_GB=110000
# GEO_BROWSER_YIYAN_SH_CDP_URL=http://127.0.0.1:19226
# GEO_BROWSER_YIYAN_SH_EXIT_GB=310000
# GEO_BROWSER_YUANBAO_TJ_CDP_URL=http://127.0.0.1:19227
# GEO_BROWSER_YUANBAO_TJ_EXIT_GB=120000
# 旧平台 slug 直配（GEO_<PLATFORM>_CDP_URL）仍受支持：per-task 老路径与
# 实例键未命中时的回退（resident_cdp_url 实例键优先、slug 兜底）。
# GEO_DOUBAO_CDP_URL=http://127.0.0.1:19222

# captcha-assist-v1 (2026-08-06): 撞码 → 手机人工接管 → 断点续跑。
# 撞验证码时 workflow 挂起（≤60min），assist activity attach 常驻浏览器起
# frame/input 中继，推送一键 URL 给管理员手机；解决后自动从断点题续跑。
# 未配置/超时/连撞>3 次 → 自动回退旧语义（撞码题 wall + 余题 aborted），绝不阻断链路。
# 公网基址（手机可达，nginx 8443 已代理 /api/v2/，零 nginx 改动）：
# GEO_ASSIST_PUBLIC_BASE=https://<your-host>:8443
# 推送通道（feishu_app=企业自建应用；feishu_webhook=旧群 webhook；
# bark|serverchan|wecom|ntfy|raw 保持兼容；旧名 feishu 已弃用但仍兼容）：
# GEO_ASSIST_NOTIFY_FLAVOR=bark
# GEO_ASSIST_NOTIFY_URL=https://api.day.app/<key>
# feishu_app 的非秘密标识从 /etc/geo-platform-v2/feishu-bot.env 加载，
# 不使用 GEO_ASSIST_NOTIFY_URL；activity 只写本地 durable outbox，不访问飞书。
# 接管会话兜底寿命（秒，缺省 4200=70min，略大于 workflow 等待窗）：
# GEO_ASSIST_TTL_S=4200

# 常驻浏览器跨 worker fencing（2026-08-06 起）：平台互斥从进程内锁升级为
# platform.browser_fence PG lease（fencing_token 单调递增，崩溃靠 expires_at 兜底回收）。
# 模式：db（缺省，多 worker 安全；DB 不可达 = fail-closed 抛 BrowserBusyError）|
#       local（纯进程内锁，仅单 worker 开发/测试用）。
# GEO_BROWSER_FENCING=db
# holder 标识（缺省 hostname:pid；多 worker 部署保持缺省即唯一，一般无需覆盖）：
# GEO_BROWSER_FENCE_HOLDER=
# lease TTL（秒，缺省 7200；assist 人工接管持锁 ~70min 给足，崩溃后兜底回收窗）：
# GEO_BROWSER_FENCE_TTL_S=7200
# 持有期间心跳续期间隔（秒，缺省 30）：
# GEO_BROWSER_FENCE_HEARTBEAT_S=30

# 原始流量证据留痕（2026-08-10 起，用户拍板「需要有、默认开」）：每个采集任务
# 在独立 CDP session 上自组本题 HAR 1.2 + 落 completion 端点原始响应体
# （SSE raw blob），随证据链进 CAS（kind=har/sse_raw，relation=answer_har/
# answer_sse_raw；运营端 AnswerExplorer 可下载）。组盘即剥 cookie/authorization/
# set-cookie 与敏感查询参数，DLP 只当双保险。失败题（wall/incomplete）同样留痕。
# 总开关（缺省 1 开；0 = 全关回退旧行为：不建 session、不落文件、不出证据 ref）：
# GEO_RAW_CAPTURE=1
# 单题 HAR 序列化上限（缺省 8 MiB，远低于 evidence 单文件 30MB 硬顶；超出走
# 截断阶梯：丢 postData.text → body 前缀截断，entries 永不丢）：
# GEO_HAR_MAX_BYTES=8388608
# 单条 completion 响应体进 HAR content 的上限（缺省 4 MiB，超出标 _truncated
# 只留前缀；sse_raw 原文文件不受此限）：
# GEO_HAR_BODY_MAX_BYTES=4194304

# INV-1 测量合格性 geo provenance（2026-08-08 起）：平台 slug → 静态住宅中继的
# 6 位出口省码（租约采集时已验出口）。fanout 据此给每题盖 geo_source/observed_gb_code；
# 未声明的平台 = unverified → eligible=false（fail-loud，宁缺不编造）。
# 2026-08-09 起（浏览器矩阵化）键从平台 slug 升级为**实例键**（与
# GEO_BROWSER_<KEY>_EXIT_GB 同值同真源）；fanout 优先按任务落库 matrix_json
# 记录的实测实例键查表，无记录（per-task 老路径/历史负载）回退 slug 键。
# 中继换上游且出口城市变化时必须同步本映射（见 RESIDENT-BROWSERS.md）。
GEO_MEASUREMENT_EXIT_GB_MAP=doubao_sh:310000,deepseek_tj:120000,tongyi_bj:110000,yiyan_sh:310000,yuanbao_tj:120000,yuanbao_bj:110000

# otp-assist-login (2026-08-07): 登录/OTP 人工接管 CLI（tools/otp_assist_login.py）。
# 场景：OTP 自动链路断（SmsForwarder 停推）后人工开户/登录——attach 常驻浏览器，
# 画面/键鼠中继到手机（复用 captcha-assist 的 ticket/注册表/手机页/推送），
# 运维终端 Enter 确认完成。工具独立运行（不经 worker），用法（2026-08-09 起
# --platform 收常驻实例键，兼容旧 slug）：
#   set -a; . /etc/geo-platform-v2/worker-adapters.env; \
#     . /etc/geo-platform-v2/feishu-bot.env; set +a
#   .venv/bin/python tools/otp_assist_login.py --platform yiyan_sh \
#       --goto https://yiyan.baidu.com/ --ttl-min 60 --note "脱敏账号开户"
# 依赖本文件三类配置：GEO_BROWSER_<KEY>_CDP_URL（缺 → exit 3）、
# GEO_ASSIST_PUBLIC_BASE / GEO_ASSIST_NOTIFY_*（未配齐须 --no-notify）、
# GEO_BROWSER_FENCING（锁，同上段）。

# OTP 收件（2026-08-07，旧 geosys 退役后 OTP 推送链整体迁入 V2）：
# 端点在 API 进程（api/geo_platform/otp），故 GEO_OTP_RELAY_TOKEN /
# GEO_OTP_OPERATOR_TOKEN / GEO_OTP_INBOX_DIR / GEO_OTP_REGISTRY_PATH 必须同时
# 写进 API 的
# /etc/geo-platform-v2/platform.env（本文件只喂 worker；GEO_OTP_OPERATOR_TOKEN
# 放这里是给 tools/otp_wait.py 取码用，值须与 platform.env 一致）。
# 推送面：SmsForwarder → POST /api/v2/otp/push（X-Relay-Token 门；env 未配 =
# 功能关闭 fail-closed 503）：
# GEO_OTP_RELAY_TOKEN=
# 取码面：GET /api/v2/otp/latest?phone=&within=（X-Operator-Token 门，明文码，
# operator 机密）：
# GEO_OTP_OPERATOR_TOKEN=
# 收件箱目录（缺省 platform-v2/runtime/otp_inbox/，自动建目录）：
# GEO_OTP_INBOX_DIR=
# APK 是 Git 忽略的运维制品；API 服务用 geo-platform-v2-otp-apk.conf 把路径固定到
# 持久工作树，避免不可变源码快照发布后默认路径漂移。生产必须同时钉住公网基址、
# APK 版本、SHA-256 与签名证书 SHA-256；任一完整性值不匹配时页面禁用下载：
# GEO_OTP_APK_PATH=/home/xln/geo-system/platform-v2/runtime/smsforwarder.apk
# GEO_OTP_APK_VERSION=3.5.0.260224
# GEO_OTP_APK_SHA256=<64 lowercase hex>
# GEO_OTP_APK_SIGNER_SHA256=<colon-separated SHA-256 fingerprint>
# GEO_PUBLIC_BASE_URL=https://<public-host>:8443
# 在册号码注册表（POST /api/v2/otp/register 落盘；缺省
# platform-v2/runtime/otp_registered_numbers.json；每日备份 runtime_state 组件同源读取）：
# GEO_OTP_REGISTRY_PATH=
# 取码 CLI（每 2s 轮询，拿到码 stdout 打印 exit 0；超时 exit 2；配置门 exit 3）：
#   set -a; . /etc/geo-platform-v2/worker-adapters.env; set +a
#   .venv/bin/python tools/otp_wait.py --phone '<registered-phone>' --timeout 180
# 采集账号治理（20260814，s06_0022）：db=派题先查治理表（无账号行自动 env 回退）；
# off=应急关停，直走 GEO_BROWSER_INSTANCES 清单序旧逻辑
GEO_ACCOUNT_GOVERNANCE=db
# 采集账号占用模型（20260901，s19_0001）：run 认领账号 = 带租约的占用
# （idle→running 写 reservation_expires_at，owned 复用续约，终态释放清空；
# Temporal terminate 卡死的占用靠「租约过期/持有 run 已终态」惰性回收自愈，
# 人工出口 = 管理端 force-release / tools/reap_account_reservations.py）。
# 租约 TTL（秒，缺省 21600=6h——必须 ≥ captcha 挂起上限 3×60min+余量，否则
# 正常挂起中的 run 会被误判失活而回收账号）：
# GEO_ACCOUNT_RESERVATION_TTL_S=21600
# 竞争排队等待（同 platform+region 账号暂时全忙时不再立即占位）：等待上限
# （秒，缺省 3600；0=不等待立即判超时）。实际预算还会被 batch activity 的
# start_to_close 截断（itemwise 段 15min/老 batch 上限 120min）——超时返回
# 区分性 error_type account_contention_timeout（区别于账号不存在的
# account_unavailable），占位结果在数据层可分辨：
# GEO_ACCOUNT_WAIT_TIMEOUT_S=3600
# 等待轮询间隔（秒，缺省 20，硬夹 ≤25 以满足 activity 30s 心跳门；每轮
# activity.heartbeat）：
# GEO_ACCOUNT_WAIT_POLL_S=20

# ---------------------------------------------------------------------------
# provider_api 采集模态（2026-08-31 起；ADR-0008 三采集面之一的 v1 管线执行体，
# 见 workflows/activities/provider_api_adapter.py docstring）
# ---------------------------------------------------------------------------
# 五平台各派生一个 *_api adapter slug（doubao_api/deepseek_api/yiyan_api/
# tongyi_api/yuanbao_api），运营端 ConfigLauncher「官方 API」分组勾选后随
# freeze/launch 进任务矩阵；region 由服务端折叠为哨兵 "api"（API 无地域出口
# 维度，INV-1 自动判 unverified 排除测量分母——**不要**为 *_api slug 配置
# GEO_MEASUREMENT_EXIT_GB_MAP 条目）。
#
# 每平台两项必填（Key/Model），缺任一项 = 该平台题级 wall/adapter_not_configured
# 诚实失败（不炸混合 surface 的 run）；BASE_URL/TIMEOUT_S 有缺省。Key 只进
# Authorization 头，绝不落日志/证据。模型 id 会随平台发版漂移，故不设缺省，
# 由运营显式钉住。每题原始响应 JSON 落证据（kind=provider_api_raw）。
#
# 豆包（火山方舟 Responses API + web_search 联网插件——恢复答案→信源 URL
# 引用与真实检索词，是 2026-08-17 起网页版 SSE 下线 text_card.summary 后
# 信源理解的替代输入；web_search 需在方舟控制台「服务组件库」先开通）：
# GEO_PROVIDER_API_ARK_API_KEY=
# GEO_PROVIDER_API_ARK_MODEL=doubao-seed-1-6-250615
# GEO_PROVIDER_API_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# GEO_PROVIDER_API_ARK_TIMEOUT_S=300
# DeepSeek（官方 API，无联网搜索参数——引用为空是平台能力的诚实反映）：
# GEO_PROVIDER_API_DEEPSEEK_API_KEY=
# GEO_PROVIDER_API_DEEPSEEK_MODEL=deepseek-chat
# GEO_PROVIDER_API_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 文心（千帆 V2 web_search：enable_citation+search_results 回传信源 URL）：
# GEO_PROVIDER_API_QIANFAN_API_KEY=
# GEO_PROVIDER_API_QIANFAN_MODEL=ernie-4.5-turbo-32k
# GEO_PROVIDER_API_QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
# 通义（百炼**原生** Generation 端点：enable_search+enable_source 回传
# search_info.search_results 搜索来源、enable_citation 开正文角标；兼容模式
# 官方明确不回传来源，故不用）：
# GEO_PROVIDER_API_DASHSCOPE_API_KEY=
# GEO_PROVIDER_API_DASHSCOPE_MODEL=qwen-plus
# GEO_PROVIDER_API_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 元宝（混元 enable_enhancement 搜索增强 + search_info=true 回传来源链接 +
# citation 正文角标；hunyuan-lite 无搜索能力，Model 须配支持增强的型号）：
# GEO_PROVIDER_API_HUNYUAN_API_KEY=
# GEO_PROVIDER_API_HUNYUAN_MODEL=hunyuan-turbos-latest
# GEO_PROVIDER_API_HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# 原始响应证据目录（缺省 platform-v2/runtime/adapter-evidence/，兜底共享项
# GEO_ADAPTER_EVIDENCE_DIR）：
# GEO_PROVIDER_API_EVIDENCE_DIR=
