# Semantic/risk policy switches. LLM credentials should remain in the protected
# platform.env or an operator-managed 0600 copy of this file.
GEO_DISPARAGEMENT_ENABLED=1
GEO_DISPARAGEMENT_FACTCHECK_ENABLED=1
GEO_SITE_SUGGESTIONS_ENABLED=1
GEO_OWN_CONTENT_DISPARAGEMENT_ENABLED=1

# Independent A/B/C source-page inspection.  It reads only public source
# snapshots already persisted by source-worker; it never uses a logged-in
# collection profile.  Missing GEO_AUDIT_LLM_API_KEY/model is recorded as
# unverifiable instead of producing synthetic findings.
GEO_PAGE_INSPECTION_ENABLED=1
# 兼容旧部署的批处理提示；不会截断 U 事实全集。
GEO_PAGE_INSPECTION_MAX_DOCUMENTS=500
# 单次模型调用的正文窗口大小；全文由重叠窗口覆盖。
GEO_PAGE_INSPECTION_MAX_CHARS=120000

# Keep credentials in the protected platform.env or an operator-owned 0600
# environment file.  Empty audit values fall back to GEO_RESEARCH_LLM_*.
# GEO_AUDIT_LLM_API_KEY=
# GEO_AUDIT_LLM_BASE_URL=
# GEO_AUDIT_LLM_MODEL=

# Service 2 relation analysis. Inject the API key from the deployment secret
# store; never commit it to this file. Empty key reuses GEO_RESEARCH_LLM_API_KEY.
# 品牌调研与 Service 2 使用同一模型选项目录；选择状态与批次冻结互不联动。
GEO_RESEARCH_LLM_MODELS=gpt-5.6-luna,qwen3.7-plus,gemini-3.1-pro-preview-search,claude-opus-5
# GEO_SERVICE2_ANALYSIS_LLM_API_KEY=
GEO_SERVICE2_ANALYSIS_LLM_BASE_URL=https://api.inferera.com
GEO_SERVICE2_ANALYSIS_LLM_BASE_URL_FALLBACK=
