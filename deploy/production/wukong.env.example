# Copy to /etc/geo-platform-v2/wukong.env as root:root mode 0600.
# Never place these credentials in worker-adapters.env, systemd unit text, or Git.
WUKONG_PHONE=replace-with-account-phone
WUKONG_PASSWORD=replace-with-account-password
WUKONG_CACHE=/home/xln/geo-system/platform-v2/runtime/wukong_leases.json

# Provider/product settings. There is no automatic/free application and no
# active/daily count cap. Paid purchase requires the explicit operator command.
WUKONG_PROJECT_ID=671
WUKONG_WEB_PROJECT_ID=1084
WUKONG_BANDWIDTH=5
WUKONG_ISP=1
