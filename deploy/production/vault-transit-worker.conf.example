# Install only on the revocation Worker after dual-control policy approval.
# The API service must not mount or be able to read this credential.
[Service]
LoadCredential=vault-deletion-token:/etc/geo-platform-v2/vault-deletion-token
Environment=GEO_KMS_PROVIDER=vault_transit
Environment=GEO_VAULT_TRANSIT_ADDRESS=https://127.0.0.1:18200
Environment=GEO_VAULT_TRANSIT_DELETION_TOKEN_FILE=/run/credentials/geo-platform-v2-worker.service/vault-deletion-token
Environment=GEO_VAULT_TRANSIT_KEY_NAME=geo-platform-profile
