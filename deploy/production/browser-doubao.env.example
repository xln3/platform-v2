# Copy to /etc/geo-platform-v2/browser-doubao.env and chmod 0600.
# Read by geo-platform-v2-browser@doubao.service（W8 常驻浏览器，CDP attach 目标）。
RESIDENT_PLATFORM=doubao
# 与 worker 侧 GEO_DOUBAO_PROFILE_DIR 同一个目录（生产 runtime/profiles/doubao-sh）；
# 必须已存在（fail-closed，绝不自动新建空 profile 丢登录态）。
RESIDENT_PROFILE_DIR=/home/xln/geo-system/platform-v2/runtime/profiles/doubao-sh
# 与 worker 侧 GEO_DOUBAO_PROXY_URL 保持一致；留空=直连。换代理=改这里 + restart 本服务。
# RESIDENT_PROXY_URL=http://user:password@proxy.example:3128
# CDP 仅监听 127.0.0.1（无鉴权，绝不绑外网）；worker 侧 GEO_DOUBAO_CDP_URL 用同一端口。
RESIDENT_CDP_PORT=19222
# headed Chromium 的显示（本机 GNOME 桌面）；缺省 :1。
RESIDENT_DISPLAY=:1
