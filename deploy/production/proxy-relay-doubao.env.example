# Copy to /etc/geo-platform-v2/proxy-relay-doubao.env and chmod 0600.
# Read by geo-platform-v2-proxy-relay@doubao.service（悟空预认证 CONNECT 中继）。
# 上游：悟空上海租约（含凭据；换节点/轮换凭据只改这里 + restart 本服务）。
UPSTREAM_PROXY_URL=http://user:password@183.131.35.19:21208
# 本地监听（仅 127.0.0.1）：常驻浏览器 RESIDENT_PROXY_URL 与 worker
# GEO_DOUBAO_PROXY_URL 都指向 http://127.0.0.1:19323。
RELAY_PORT=19323
