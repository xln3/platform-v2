# Non-secret identifiers/settings for the Feishu enterprise custom application.
# Secret material is supplied by systemd LoadCredential in the service unit.
GEO_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
GEO_FEISHU_TENANT_KEY=xxxxxxxxxxxxxxxx
GEO_FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxx
GEO_ASSIST_PUBLIC_BASE=https://geo.example.com:8443
# Stable absolute path shared by API, main worker, OTP CLI, and bot snapshots.
GEO_ASSIST_REGISTRY_DIR=/home/xln/geo-system/platform-v2/runtime/captcha-assist
GEO_FEISHU_API_BASE_URL=https://open.feishu.cn
GEO_FEISHU_BOT_ADDRESS=127.0.0.1
GEO_FEISHU_BOT_PORT=18092
GEO_FEISHU_CALLBACK_MAX_AGE_SECONDS=300
GEO_FEISHU_SENDER_POLL_SECONDS=1
GEO_FEISHU_SENDER_BATCH_SIZE=20
GEO_FEISHU_SENDER_MAX_ATTEMPTS=8
GEO_FEISHU_ALERT_REPEAT_WINDOW_SECONDS=14400
GEO_FEISHU_ALERT_CARD_UPDATE_SECONDS=900
GEO_FEISHU_ALERT_WARNING_NAMES=GeoCollectionRunStalled
# Optional local-time warning quiet window; resolved closures are still processed.
# GEO_FEISHU_ALERT_QUIET_HOURS=23:00-07:00
GEO_FEISHU_ALERT_TIMEZONE=Asia/Shanghai
# Optional @ duty operator for assist and firing critical cards.
GEO_FEISHU_MENTION_ONCALL=0
# GEO_FEISHU_ONCALL_OPEN_ID=ou_xxxxxxxxxxxxxxxx

# Activate separately after test-group smoke validation:
# GEO_ASSIST_NOTIFY_FLAVOR=feishu_app
# GEO_ALERT_NOTIFY_CHANNEL=feishu_app
