# Copy to /etc/geo-platform-v2/proxy-relay-sh.env and chmod 0600.
# Read by geo-platform-v2-proxy-relay@sh.service（悟空预认证 CONNECT 中继）。
# 中继实例标签 = 出口地域（sh/tj/bj），不是平台 slug——同地域多平台共用一个
# 中继（doubao_sh+yiyan_sh 共用 :19323）。2026-08-09 起 relay@doubao 改名
# relay@sh（19323 实为上海出口的历史误命名）。
# 上游：悟空上海租约（含凭据；换节点/轮换凭据只改这里 + restart 本服务）。
UPSTREAM_PROXY_URL=http://user:password@183.131.35.19:21208
# 本地监听（仅 127.0.0.1）：常驻浏览器 RESIDENT_PROXY_URL 与 worker
# GEO_<P>_PROXY_URL 都指向本地中继端口。
RELAY_PORT=19323
