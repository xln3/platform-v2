# Browser workers: enable only together with the root browser controller in apply mode.
GEO_BROWSER_ELASTIC_ENABLED=0

# Separate paid-resource controller. Empty desired regions and zero budget disable spend.
# GB codes must describe actual desired regional capacity, not temporary network errors.
GEO_ELASTIC_PROXY_REGIONS=
GEO_ELASTIC_PROXY_MAX_PURCHASES_PER_DAY=0
GEO_ELASTIC_PROXY_AUTO_BUY=0
GEO_ELASTIC_PROXY_AUTO_ACTIVATE=0

# Use the canonical provider configuration from worker-adapters.env:
# GEO_REGION_PROXY_MODE=wukong
# GEO_WUKONG_MODULE_ROOT=/home/xln/geo-system/server
# GEO_WUKONG_CACHE=/home/xln/geo-system/platform-v2/runtime/wukong_leases.json
# Do not create a second provider cache or purchase loop.
