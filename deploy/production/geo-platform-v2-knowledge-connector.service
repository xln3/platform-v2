[Unit]
Description=Process queued shared-knowledge connector requests
After=geo-platform-v2-api.service

[Service]
Type=oneshot
User=xln
Group=xln
WorkingDirectory=/opt/geo-platform-v2/current
EnvironmentFile=/etc/geo-platform-v2/platform.env
Environment=GEO_SILICONINDEX_SNAPSHOT_DIR=/var/lib/geo-platform-v2/siliconindex
Environment=GEO_KNOWLEDGE_RELEASE_DIR=/var/lib/geo-platform-v2/knowledge
Environment=GEO_SILICONINDEX_PUBLISHER_ENABLED=true
Environment=GEO_SILICONINDEX_PUBLISHER_REPOSITORY_URL=git@github.com:suzakuzhang/siliconindex-consumer.git
Environment=GEO_SILICONINDEX_PUBLISHER_BRANCH=main
ExecStart=/opt/geo-platform-v2/current/.venv/bin/python tools/run_knowledge_connector_queue.py
StateDirectory=geo-platform-v2/knowledge geo-platform-v2/siliconindex
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027
