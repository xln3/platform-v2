# Non-secret OIDC settings. Use this mode only after the production issuer,
# audience, JWKS endpoint, identity bindings and all required roles are verified.
# Self-hosted production uses native_session until then.
GEO_IDENTITY_MODE=oidc
GEO_OIDC_ISSUER=https://identity.example.com
GEO_OIDC_AUDIENCE=https://geo.example.com/api/v2
GEO_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
GEO_OIDC_ALGORITHMS=RS256
GEO_OIDC_TENANT_CLAIM=https://geo.example/tenant
GEO_OIDC_MAX_TOKEN_LIFETIME_SECONDS=900
GEO_OIDC_CLOCK_SKEW_SECONDS=30
GEO_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/oauth2/authorize
GEO_OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth2/token
GEO_OIDC_CLIENT_ID=geo-platform-v2-browser
GEO_OIDC_REDIRECT_URI=https://geo.example.com/api/v2/identity/callback
GEO_OIDC_POST_LOGIN_URI=/platform/customer/
GEO_OIDC_BROWSER_COOKIE_KEY_FILE=/run/credentials/geo-platform-v2-api.service/oidc-cookie-key

# Independent Ed25519 seed used only to sign short-lived customer-terminal tasks.
GEO_TERMINAL_TASK_SIGNING_KEY_FILE=/run/credentials/geo-platform-v2-api.service/terminal-task-signing-key

# No client secret, access token, refresh token, private key or user identifier
# belongs in this file. The cookie key is a base64url-encoded 32-byte random key
# supplied as an owner-only, non-symlinked systemd credential. Do not put it in
# the environment. Live IdP registration and role bindings remain external.
