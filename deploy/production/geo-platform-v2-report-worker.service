[Unit]
Description=GEO Platform V2 Frozen Snapshot Report Temporal Worker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=xln
Group=xln
WorkingDirectory=/home/xln/geo-system/platform-v2
EnvironmentFile=/etc/geo-platform-v2/platform.env
EnvironmentFile=-/etc/geo-platform-v2/report-worker.env
ExecStartPre=/home/xln/geo-system/platform-v2/.venv/bin/python -c "from domain.reporting.libreoffice import report_runtime_preflight; report_runtime_preflight()"
ExecStart=/home/xln/geo-system/platform-v2/.venv/bin/python -m workflows.workers.report
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/xln/geo-system/platform-v2

[Install]
WantedBy=multi-user.target
