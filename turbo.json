{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CHOKIDAR_USEPOLLING",
    "GEO_E2E_BUILD",
    "GEO_VITE_NO_WATCH",
    "VITE_ALLOW_CONTRACT_FIXTURES",
    "VITE_GEO_API_BASE"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["build/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "outputs": [] }
  }
}
