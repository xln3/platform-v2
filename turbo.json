{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CHOKIDAR_USEPOLLING"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["build/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] }
  }
}
