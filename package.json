{
  "name": "geo-platform-v2",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "CHOKIDAR_USEPOLLING=true turbo run build --concurrency=1 --force",
    "dev:web": "turbo run dev --filter='./apps/*'",
    "lint": "turbo run lint && pnpm lint:python",
    "lint:python": ".venv/bin/ruff check api domain workflows migrations tests tools scripts",
    "format": "prettier --write . && .venv/bin/ruff format api domain workflows migrations tests tools scripts",
    "format:check": "prettier --check . && .venv/bin/ruff format --check api domain workflows migrations tests tools scripts",
    "typecheck": "turbo run typecheck && .venv/bin/mypy api workflows domain",
    "test": "turbo run test --concurrency=1 && pnpm test:e2e-runtime-unit && pnpm test:python",
    "test:python": "bash scripts/test_python.sh",
    "test:python:slow": ".venv/bin/pytest -q -m slow --fail-on-skip",
    "test:python:services": ".venv/bin/pytest -q -m service_integration --fail-on-skip",
    "test:python:isolated": ".venv/bin/pytest -q -m isolated_postgres --fail-on-skip",
    "test:python:knowledge": ".venv/bin/pytest -q -m knowledge_postgres --fail-on-skip",
    "test:python:compat": ".venv/bin/pytest -q -m compat_postgres --fail-on-skip",
    "test:python:external": ".venv/bin/pytest -q -m external_fixture --fail-on-skip",
    "test:python:documents": ".venv/bin/pytest -q -m document_toolchain --fail-on-skip",
    "test:e2e-runtime-unit": "vitest run tests/e2e/runtime-guard.test.ts tests/e2e/screenshot-safety.test.ts tools/browser_runtime_evidence.test.mjs tools/production_browser_topology.test.mjs --environment node",
    "test:e2e": "pnpm test:e2e:contract",
    "test:e2e:contract": "playwright test --grep-invert @live-api",
    "test:e2e:live": "playwright test --grep @live-api --project=operations-desktop",
    "test:e2e:all": "playwright test",
    "test:vault-integration": ".venv/bin/python tools/test_vault_transit_integration.py",
    "generate:api": ".venv/bin/python scripts/export_openapi.py && openapi-typescript contracts/openapi.json -o packages/api-client/src/schema.generated.ts",
    "check:api": "pnpm generate:api && .venv/bin/python scripts/check_generated.py && .venv/bin/python scripts/check_frontend_contracts.py",
    "check:production-routes": ".venv/bin/python scripts/check_production_routes.py",
    "check:ci": ".venv/bin/python scripts/check_ci_workflow.py",
    "check:e2e-artifacts": ".venv/bin/python scripts/check_e2e_artifacts.py",
    "check:observability": ".venv/bin/python scripts/check_observability_alerts.py",
    "check:production-bundles": ".venv/bin/python scripts/check_production_bundles.py",
    "frontend:release": ".venv/bin/python scripts/frontend_release.py",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm check:api && pnpm build && pnpm check:e2e-artifacts && pnpm check:production-bundles && pnpm check:production-routes && pnpm check:observability && pnpm check:ci",
    "infra:up": "docker compose -f compose.yaml up -d --wait",
    "infra:down": "docker compose -f compose.yaml down",
    "dev": "bash scripts/dev.sh",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.1.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
